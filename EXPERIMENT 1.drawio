        <mxCell id="e4" edge="1" parent="1" source="shortservice" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" target="idgen" value="Generate unique code">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="shortservice" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" target="database" value="Store mapping">
