        </mxCell>
        <mxCell id="redis" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontStyle=1;" value="Redis Cache&#xa;short_code → original_url" vertex="1">
          <mxGeometry height="100" width="300" x="1890" y="880" as="geometry" />
        </mxCell>
        <mxCell id="database" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fontSize=16;fontStyle=1;" value="URL Database&#xa;Persistent URL Mapping" vertex="1">
          <mxGeometry height="120" width="280" x="1550" y="1030" as="geometry" />
        </mxCell>
        <mxCell id="backup" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fontSize=14;fontStyle=1;" value="Replication / Backup" vertex="1">
          <mxGeometry height="90" width="240" x="1570" y="1250" as="geometry" />
        </mxCell>
