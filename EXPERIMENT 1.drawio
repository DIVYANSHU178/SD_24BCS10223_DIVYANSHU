        </mxCell>
        <mxCell id="idgen" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;" value="ID Generator&#xa;+ Base62 Encoder&#xa;a-z A-Z 0-9&#xa;62⁷ ≈ 3.52 trillion codes" vertex="1">
