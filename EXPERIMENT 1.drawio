        </mxCell>
        <mxCell id="e6" edge="1" parent="1" source="redirectservice" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" target="redis" value="Cache lookup">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" edge="1" parent="1" source="redis" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" target="database" value="Cache miss → DB query">
