        <mxCell id="box_cdn" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;strokeWidth=2;verticalAlign=top;align=center;spacingTop=6;" value="&lt;b style=&#39;font-size: 13px; color: #991B1B;&#39;&gt;NETFLIX OPEN CONNECT (CDN)&lt;/b&gt;" vertex="1">
