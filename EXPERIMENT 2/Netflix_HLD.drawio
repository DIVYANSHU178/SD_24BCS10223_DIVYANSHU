        </mxCell>
        <mxCell id="node_cdn_isp" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DC2626;strokeWidth=2;align=left;spacingLeft=10;" value="&lt;b&gt;Open Connect Appliance (OCA)&lt;/b&gt;&lt;br&gt;&lt;b style=&#39;color:#B91C1C;&#39;&gt;Deployed inside Local ISP (Jio / Airtel)&lt;/b&gt;&lt;br&gt;• Physically located in user&#39;s city/ISP&lt;br&gt;• High-speed SSDs with popular videos&lt;br&gt;• Delivers 95%+ of video data locally&lt;br&gt;• Eliminates lag and buffering!" vertex="1">
          <mxGeometry height="115" width="300" x="1810" y="575" as="geometry" />
        </mxCell>
        <mxCell id="node_cdn_nightly" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#F87171;strokeWidth=1;align=left;spacingLeft=8;fontSize=10;" value="&lt;b&gt;Proactive Nightly Caching (Fill)&lt;/b&gt;&lt;br&gt;During night (2 AM - 5 AM), the CDN pre-downloads anticipated hit movies from AWS S3 so they are ready for evening rush!" vertex="1">
          <mxGeometry height="65" width="300" x="1810" y="715" as="geometry" />
        </mxCell>
        <mxCell id="node_cdn_abr" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FCA5A5;strokeWidth=1;align=left;spacingLeft=8;fontSize=10;" value="&lt;b&gt;How Video Reaches Client:&lt;/b&gt;&lt;br&gt;Videos are stored in 2 to 5-second chunks. The client&#39;s video player requests chunk 1, chunk 2, chunk 3 directly from this OCA via HTTPS!" vertex="1">
          <mxGeometry height="65" width="300" x="1810" y="840" as="geometry" />
        </mxCell>
        <mxCell id="box_trans_pipeline" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=15;spacingTop=8;" value="&lt;b style=&#39;font-size: 13px; color: #92400E;&#39;&gt;OFFLINE VIDEO INGESTION &amp;amp; TRANSCODING PIPELINE (HOW A NEW MOVIE IS ADDED)&lt;/b&gt;" vertex="1">
          <mxGeometry height="145" width="1530" x="600" y="1055" as="geometry" />
        </mxCell>
        <mxCell id="step_t1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;align=center;" value="&lt;b&gt;[Step 1] Upload Master&lt;/b&gt;&lt;br&gt;Studio uploads 4K raw master video (30-50GB) to S3" vertex="1">
          <mxGeometry height="55" width="240" x="620" y="1110" as="geometry" />
        </mxCell>
        <mxCell id="step_t2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;align=center;" value="&lt;b&gt;[Step 2] Chunking&lt;/b&gt;&lt;br&gt;Master video is sliced into parallel 2-to-5 second chunks" vertex="1">
          <mxGeometry height="55" width="240" x="900" y="1110" as="geometry" />
        </mxCell>
        <mxCell id="step_t3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;align=center;" value="&lt;b&gt;[Step 3] Multi-Encoding&lt;/b&gt;&lt;br&gt;Transcoder converts chunks to 360p, 480p, 720p, 1080p, 4K" vertex="1">
          <mxGeometry height="55" width="260" x="1200" y="1110" as="geometry" />
        </mxCell>
        <mxCell id="step_t4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;align=center;" value="&lt;b&gt;[Step 4] DRM &amp;amp; Manifest&lt;/b&gt;&lt;br&gt;Chunks encrypted; .mpd/.m3u8 index file created and saved in S3" vertex="1">
          <mxGeometry height="55" width="270" x="1520" y="1110" as="geometry" />
        </mxCell>
        <mxCell id="step_t5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE68A;strokeColor=#B45309;strokeWidth=1.5;align=center;" value="&lt;b&gt;[Step 5] CDN Push&lt;/b&gt;&lt;br&gt;Pushed to global ISP CDN servers ahead of release!" vertex="1">
          <mxGeometry height="55" width="260" x="1840" y="1110" as="geometry" />
        </mxCell>
        <mxCell id="arr_t1" edge="1" parent="1" source="step_t1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D97706;strokeWidth=2;" target="step_t2" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arr_t2" edge="1" parent="1" source="step_t2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D97706;strokeWidth=2;" target="step_t3" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arr_t3" edge="1" parent="1" source="step_t3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D97706;strokeWidth=2;" target="step_t4" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arr_t4" edge="1" parent="1" source="step_t4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D97706;strokeWidth=2;" target="step_t5" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note_trans" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#78350F;" value="&lt;i&gt;Why Transcoding is necessary:&lt;/i&gt; Different users have different screens (4-inch mobile vs 65-inch 4K TV) and different connection speeds (2G, 4G, Fiber Wi-Fi). Storing multiple encoded versions allows the client to switch quality on the fly!" vertex="1">
          <mxGeometry height="30" width="1470" x="750" y="1170" as="geometry" />
        </mxCell>
        <mxCell id="box_flows_desc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=15;spacingTop=8;" value="&lt;b style=&#39;font-size: 13px; color: #1E293B;&#39;&gt;STEP-BY-STEP USER WORKFLOWS (HOW THE SYSTEM CONNECTS TOGETHER)&lt;/b&gt;" vertex="1">
          <mxGeometry height="196.25" width="1530" x="600" y="1220" as="geometry" />
        </mxCell>
        <mxCell id="flow_step1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93C5FD;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" value="&lt;b style=&quot;color: rgb(29, 78, 216); font-size: 12px;&quot;&gt;FLOW 1: Browse &amp;amp; Search Flow&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1.&lt;/b&gt; User opens Netflix app &amp;amp; searches or opens home feed.&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; Request passes through &lt;b&gt;DNS&lt;/b&gt; and &lt;b&gt;Load Balancer&lt;/b&gt; to&amp;nbsp;&lt;b&gt;API Gateway&lt;/b&gt;.&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; Gateway verifies JWT token and calls &lt;b&gt;Catalog Service&lt;/b&gt;.&lt;br&gt;&lt;b&gt;4.&lt;/b&gt; Catalog Service checks &lt;b&gt;Redis Cache&lt;/b&gt;. On cache hit, returns in &amp;lt;5ms. If cache miss, reads from database and updates Redis.&lt;br&gt;&lt;b&gt;5.&lt;/b&gt; User sees movie posters and list." vertex="1">
          <mxGeometry height="145" width="460" x="610" y="1260" as="geometry" />
        </mxCell>
        <mxCell id="flow_step2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6EE7B7;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" value="&lt;b style=&#39;color:#047857; font-size:12px;&#39;&gt;FLOW 2: Video Playback Initiation Flow&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1.&lt;/b&gt; User clicks &lt;b style=&#39;color:#E50914;&#39;&gt;PLAY&lt;/b&gt; on a movie.&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; Client sends request to &lt;b&gt;Playback Service&lt;/b&gt; via API Gateway.&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; Playback Service checks user subscription in &lt;b&gt;MySQL&lt;/b&gt; and fetches resume timestamp from &lt;b&gt;Cassandra&lt;/b&gt;.&lt;br&gt;&lt;b&gt;4.&lt;/b&gt; Playback Service determines user&#39;s ISP &amp;amp; IP and selects the &lt;b&gt;closest Open Connect CDN server (OCA)&lt;/b&gt;.&lt;br&gt;&lt;b&gt;5.&lt;/b&gt; Returns a &lt;b&gt;Manifest (.mpd)&lt;/b&gt; containing CDN URLs to the client." vertex="1">
          <mxGeometry height="145" width="480" x="1100" y="1260" as="geometry" />
        </mxCell>
        <mxCell id="flow_step3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FCA5A5;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" value="&lt;b style=&#39;color:#B91C1C; font-size:12px;&#39;&gt;FLOW 3: Real-Time Video Streaming &amp;amp; State Sync&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1.&lt;/b&gt; Client bypasses cloud backend and connects &lt;b&gt;directly to ISP Open Connect CDN&lt;/b&gt;!&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; Client requests 2-to-5 second video chunks via HTTPS.&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; If network slows down, client player automatically requests smaller 480p chunks (Adaptive Bitrate - ABR).&lt;br&gt;&lt;b&gt;4.&lt;/b&gt; Every 10 seconds, client sends a lightweight heartbeat to &lt;b&gt;Kafka&lt;/b&gt; to save viewing progress in &lt;b&gt;Cassandra&lt;/b&gt; (Continue Watching)." vertex="1">
          <mxGeometry height="145" width="490" x="1620" y="1260" as="geometry" />
        </mxCell>
