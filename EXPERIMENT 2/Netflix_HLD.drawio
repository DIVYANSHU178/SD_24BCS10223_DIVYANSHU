<mxfile host="app.diagrams.net" agent="Mozilla/5.0">
  <diagram id="netflix-student-hld" name="Netflix System Design (Experiment 2)">
    <mxGraphModel dx="2943" dy="1640" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="main_title" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#D1D5DB;strokeWidth=2;align=center;verticalAlign=middle;" value="&lt;b style=&quot;font-size: 22px; color: rgb(229, 9, 20);&quot;&gt;SYSTEM DESIGN EXPERIMENT 2: HIGH-LEVEL DESIGN (HLD) OF NETFLIX&lt;/b&gt;&lt;div&gt;&lt;br/&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="2130" x="35" y="20" as="geometry" />
        </mxCell>
        <mxCell id="sec1_container" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=12;" value="&lt;b style=&quot;font-size: 15px; color: rgb(30, 58, 138);&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; 1. REQUIREMENTS (FUNCTIONAL &amp;amp; NON-FUNCTIONAL)&lt;/b&gt;" vertex="1">
          <mxGeometry height="500" width="530" x="30" y="100" as="geometry" />
        </mxCell>
        <mxCell id="sec1_fr" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93C5FD;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=11;" value="&lt;b style=&#39;font-size: 13px; color: #1E40AF;&#39;&gt;A. Functional Requirements (What the system must DO):&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Video Streaming:&lt;/b&gt; Users should be able to play/stream videos smoothly without buffering.&lt;br&gt;• &lt;b&gt;Adaptive Bitrate (ABR):&lt;/b&gt; Video quality automatically adjusts (360p, 480p, 720p, 1080p, 4K) based on user&#39;s internet speed.&lt;br&gt;• &lt;b&gt;Search &amp;amp; Discovery:&lt;/b&gt; Users can search movies/shows by title, genre, language, or actors, and browse the homepage.&lt;br&gt;• &lt;b&gt;Continue Watching (Playback State):&lt;/b&gt; System must remember watch history and exact timestamp so user can resume anytime on any device.&lt;br&gt;• &lt;b&gt;User Accounts &amp;amp; Profiles:&lt;/b&gt; Sign up, login, subscription plans, and multiple viewer profiles per account.&lt;br&gt;• &lt;b&gt;Video Upload &amp;amp; Transcoding (Admin/Creator):&lt;/b&gt; Admins/studios can upload new movies which are automatically converted into different formats/resolutions." vertex="1">
          <mxGeometry height="210" width="500" x="45" y="150" as="geometry" />
        </mxCell>
        <mxCell id="sec1_nfr" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93C5FD;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=11;" value="&lt;b style=&#39;font-size: 13px; color: #1E40AF;&#39;&gt;B. Non-Functional Requirements (System Quality &amp;amp; Performance):&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;High Availability (99.99%):&lt;/b&gt; Streaming service must always be online. If recommendations fail, video playback must still work.&lt;br&gt;• &lt;b&gt;Low Latency (Fast Start):&lt;/b&gt; Video should start playing within &amp;lt; 1 second of pressing &#39;Play&#39; (minimal buffering).&lt;br&gt;• &lt;b&gt;Scalability:&lt;/b&gt; System must easily handle traffic spikes when a popular movie/series releases (millions of concurrent users).&lt;br&gt;• &lt;b&gt;Reliability &amp;amp; Fault Tolerance:&lt;/b&gt; No single point of failure (SPOF). If one server or database crashes, traffic routes to another.&lt;br&gt;• &lt;b&gt;Data Consistency:&lt;/b&gt;&lt;br&gt;  - &lt;i&gt;Strong Consistency:&lt;/i&gt; For user account, billing, and payment records.&lt;br&gt;  - &lt;i&gt;Eventual Consistency:&lt;/i&gt; For watch history, ratings, and view counts." vertex="1">
          <mxGeometry height="210" width="500" x="45" y="375" as="geometry" />
        </mxCell>
        <mxCell id="sec2_container" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=12;" value="&lt;b style=&quot;font-size: 15px; color: rgb(124, 45, 18);&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;2. BACK OF THE ENVELOPE (BOE) ESTIMATION&lt;/b&gt;" vertex="1">
          <mxGeometry height="865" width="530" x="30" y="615" as="geometry" />
        </mxCell>
        <mxCell id="sec2_card1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FCD34D;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=11;" value="&lt;b style=&#39;font-size: 13px; color: #9A3412;&#39;&gt;A. Traffic &amp;amp; Active Users Assumptions:&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Total Registered Subscribers:&lt;/b&gt; 250 Million&lt;br&gt;• &lt;b&gt;Daily Active Users (DAU):&lt;/b&gt; ~50 Million users/day (20% of total)&lt;br&gt;• &lt;b&gt;Peak Concurrent Viewers:&lt;/b&gt; ~10 Million streams at peak evening hours&lt;br&gt;• &lt;b&gt;Average Watch Time:&lt;/b&gt; 2 hours per active user per day" vertex="1">
          <mxGeometry height="110" width="500" x="45" y="660" as="geometry" />
        </mxCell>
        <mxCell id="sec2_card2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FCD34D;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=11;" value="&lt;b style=&quot;font-size: 13px; color: rgb(154, 52, 18);&quot;&gt;B. Storage Estimation (Video Files &amp;amp; Metadata):&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Total Movie &amp;amp; Series Catalog:&lt;/b&gt; 10,000 titles&lt;br&gt;• &lt;b&gt;Raw Master File Size:&lt;/b&gt; ~30 GB per title (high quality studio master)&lt;br&gt;• &lt;b&gt;Multiple Resolutions &amp;amp; Formats:&lt;/b&gt;&lt;br&gt;  - 1080p (FHD): ~2.5 GB&lt;br&gt;  - 720p (HD): ~1.2 GB&lt;br&gt;  - 480p (SD): ~600 MB&lt;br&gt;  - 360p (Mobile): ~300 MB&lt;br&gt;  - Audio tracks &amp;amp; subtitles in multiple languages: ~400 MB&lt;br&gt;  • &lt;b&gt;Total Transcoded Size per Title:&lt;/b&gt; ~5 GB&lt;br&gt;• &lt;b&gt;Total Video Storage Needed:&lt;/b&gt;&lt;br&gt;  10,000 titles × 5 GB = 50,000 GB = &lt;b style=&quot;color: rgb(180, 83, 9);&quot;&gt;50 TB (Terabytes)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;With Backup &amp;amp; Replication (3 regions):&lt;/b&gt; 50 TB × 3 = &lt;b&gt;150 TB in S3&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;User Metadata Storage (Database):&lt;/b&gt;&lt;br&gt;  - User profile, settings, preferences: ~2 KB&lt;br&gt;  - Watch history &amp;amp; bookmarks: ~8 KB&lt;br&gt;  - Total per user = ~10 KB&lt;br&gt;  - Total DB Size: 250M users × 10 KB = &lt;b style=&quot;color: rgb(180, 83, 9);&quot;&gt;2.5 TB&amp;nbsp;&lt;/b&gt;" vertex="1">
          <mxGeometry height="305" width="500" x="45" y="780" as="geometry" />
        </mxCell>
        <mxCell id="sec2_card3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FCD34D;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=11;" value="&lt;b style=&#39;font-size: 13px; color: #9A3412;&#39;&gt;C. Bandwidth &amp;amp; Network Egress Estimation:&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Average Stream Bitrate:&lt;/b&gt; 2.5 Mbps (blended average of mobile &amp;amp; HD streams)&lt;br&gt;• &lt;b&gt;Peak Concurrent Streams:&lt;/b&gt; 10,000,000 active streams&lt;br&gt;• &lt;b&gt;Total Peak Bandwidth Egress:&lt;/b&gt;&lt;br&gt;  10,000,000 users × 2.5 Mbps = 25,000,000 Mbps = &lt;b style=&#39;color:#B45309;&#39;&gt;25 Tbps (Terabits/sec)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;i style=&#39;color:#78350F;&#39;&gt;Key Takeaway:&lt;/i&gt; Standard cloud servers CANNOT handle 25 Tbps directly without crashing!&lt;br&gt;  Hence, &lt;b&gt;CDN (Content Delivery Network / Open Connect)&lt;/b&gt; is required.&lt;br&gt;  CDN edge caches handle &lt;b&gt;&amp;gt;95% of video bandwidth&lt;/b&gt; locally at ISP level!" vertex="1">
          <mxGeometry height="160" width="500" x="45" y="1100" as="geometry" />
        </mxCell>
        <mxCell id="sec2_card4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FCD34D;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=11;" value="&lt;b style=&#39;font-size: 13px; color: #9A3412;&#39;&gt;D. Requests Per Second (QPS) Estimation:&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Search &amp;amp; Browsing API Requests:&lt;/b&gt;&lt;br&gt;  - 50M DAU × 10 clicks/searches per day = 500,000,000 requests/day&lt;br&gt;  - Average QPS = 500,000,000 / 86,400 seconds ≈ &lt;b&gt;5,800 QPS&lt;/b&gt;&lt;br&gt;  - Peak QPS (2x average) ≈ &lt;b style=&#39;color:#B45309;&#39;&gt;12,000 QPS&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Playback Heartbeat Beacons:&lt;/b&gt;&lt;br&gt;  - 10M concurrent streams send a progress beacon every 10 seconds&lt;br&gt;  - Heartbeat QPS = 10,000,000 / 10s = &lt;b style=&#39;color:#B45309;&#39;&gt;1,000,000 QPS&lt;/b&gt;&lt;br&gt;  - Ingested via lightweight &lt;b&gt;Kafka cluster&lt;/b&gt; so web servers aren&#39;t overloaded." vertex="1">
          <mxGeometry height="175" width="500" x="45" y="1280" as="geometry" />
        </mxCell>
        <mxCell id="iSXXC790EoFp7RAx_GNQ-3" edge="1" parent="1" source="sec3_container" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1369.5" y="100.00000000000011" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sec3_container" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=12;" value="&lt;b style=&quot;font-size: 15px; color: rgb(6, 95, 70);&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; 3. SYSTEM COMPONENTS USED &amp;amp; THEIR ROLES&lt;/b&gt;" vertex="1">
          <mxGeometry height="305" width="1580" x="580" y="100" as="geometry" />
        </mxCell>
        <mxCell id="comp_client" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6EE7B7;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;" value="&lt;b style=&#39;color:#065F46; font-size:12px;&#39;&gt;1. Client Devices&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:10px; color:#374151;&#39;&gt;• Smart TV, Mobile, Web Browser&lt;br&gt;• Displays UI &amp;amp; Movie catalog&lt;br&gt;• Runs ABR logic (switches quality dynamically based on Wi-Fi speed)&lt;br&gt;• Decrypts protected video streams&lt;/span&gt;" vertex="1">
          <mxGeometry height="115" width="240" x="600" y="150" as="geometry" />
        </mxCell>
        <mxCell id="comp_dns" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6EE7B7;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;" value="&lt;b style=&#39;color:#065F46; font-size:12px;&#39;&gt;2. DNS &amp;amp; Load Balancer&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:10px; color:#374151;&#39;&gt;• &lt;b&gt;DNS (Route 53):&lt;/b&gt; Directs user to nearest data center based on geo-location.&lt;br&gt;• &lt;b&gt;Load Balancer (Nginx/ALB):&lt;/b&gt; Distributes incoming API traffic equally across backend servers to prevent overload.&lt;/span&gt;" vertex="1">
          <mxGeometry height="115" width="240" x="860" y="150" as="geometry" />
        </mxCell>
        <mxCell id="comp_gw" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6EE7B7;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;" value="&lt;b style=&quot;color: rgb(6, 95, 70); font-size: 12px;&quot;&gt;3. API Gateway&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: rgb(55, 65, 81);&quot;&gt;• Single entry point for all mobile &amp;amp; TV client requests.&lt;br&gt;• Verifies user authentication (JWT).&lt;br&gt;• Rate limiting (stops spam/DDoS).&lt;br&gt;• Routes requests to appropriate microservice.&lt;/span&gt;" vertex="1">
          <mxGeometry height="115" width="240" x="1120" y="150" as="geometry" />
        </mxCell>
        <mxCell id="comp_micro" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6EE7B7;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;" value="&lt;b style=&#39;color:#065F46; font-size:12px;&#39;&gt;4. Backend Microservices&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:10px; color:#374151;&#39;&gt;• &lt;b&gt;Auth Service:&lt;/b&gt; Login, Signup, Passwords.&lt;br&gt;• &lt;b&gt;User Service:&lt;/b&gt; Profiles, Subscriptions.&lt;br&gt;• &lt;b&gt;Catalog Service:&lt;/b&gt; Movie metadata &amp;amp; Search.&lt;br&gt;• &lt;b&gt;Playback Service:&lt;/b&gt; Generates video link &amp;amp; finds closest CDN server.&lt;/span&gt;" vertex="1">
          <mxGeometry height="115" width="240" x="1380" y="150" as="geometry" />
        </mxCell>
        <mxCell id="comp_trans" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6EE7B7;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;" value="&lt;b style=&#39;color:#065F46; font-size:12px;&#39;&gt;5. Transcoding Pipeline&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:10px; color:#374151;&#39;&gt;• Chunks raw movie files into 2-5 sec pieces.&lt;br&gt;• Encodes chunks into H.264, H.265, AV1.&lt;br&gt;• Creates 360p, 480p, 720p, 1080p, 4K.&lt;br&gt;• Generates Manifest (.mpd / .m3u8) file so client can switch bitrates.&lt;/span&gt;" vertex="1">
          <mxGeometry height="115" width="240" x="1640" y="150" as="geometry" />
        </mxCell>
        <mxCell id="comp_cdn" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6EE7B7;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;" value="&lt;b style=&#39;color:#065F46; font-size:12px;&#39;&gt;6. CDN (Open Connect)&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:10px; color:#374151;&#39;&gt;• Dedicated edge cache servers placed physically inside local ISPs (Airtel, Jio, Comcast).&lt;br&gt;• Stores popular video chunks near user.&lt;br&gt;• Streams 95%+ of video data directly without touching the central cloud!&lt;/span&gt;" vertex="1">
          <mxGeometry height="115" width="240" x="1900" y="150" as="geometry" />
        </mxCell>
        <mxCell id="comp_db_sql" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6EE7B7;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="&lt;b style=&#39;color:#065F46; font-size:11px;&#39;&gt;MySQL / Relational DB (RDBMS)&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:10px; color:#374151;&#39;&gt;Used for &lt;b&gt;Billing, Payments &amp;amp; Subscriptions&lt;/b&gt;. Guarantees strict ACID properties and data consistency (no double billing).&lt;/span&gt;" vertex="1">
          <mxGeometry height="85" width="370" x="600" y="280" as="geometry" />
        </mxCell>
        <mxCell id="comp_db_nosql" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6EE7B7;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="&lt;b style=&#39;color:#065F46; font-size:11px;&#39;&gt;NoSQL DB (Cassandra / MongoDB)&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:10px; color:#374151;&#39;&gt;Used for &lt;b&gt;User Watch History &amp;amp; Bookmarks&lt;/b&gt;. Fast write throughput for billions of viewing timestamps partitioned by User ID.&lt;/span&gt;" vertex="1">
          <mxGeometry height="85" width="370" x="990" y="280" as="geometry" />
        </mxCell>
        <mxCell id="comp_db_redis" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6EE7B7;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="&lt;b style=&#39;color:#065F46; font-size:11px;&#39;&gt;In-Memory Cache (Redis)&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:10px; color:#374151;&#39;&gt;Caches &lt;b&gt;Trending Movies &amp;amp; User Profiles&lt;/b&gt;. Provides sub-millisecond read response times and reduces database load by 80%.&lt;/span&gt;" vertex="1">
          <mxGeometry height="85" width="370" x="1380" y="280" as="geometry" />
        </mxCell>
        <mxCell id="comp_db_s3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6EE7B7;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="&lt;b style=&#39;color:#065F46; font-size:11px;&#39;&gt;Object Storage (AWS S3)&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:10px; color:#374151;&#39;&gt;Stores &lt;b&gt;Raw Master Videos &amp;amp; Encoded Chunks&lt;/b&gt;. Highly durable, infinite cloud storage; serves as the master source for CDNs.&lt;/span&gt;" vertex="1">
          <mxGeometry height="85" width="370" x="1770" y="280" as="geometry" />
        </mxCell>
        <mxCell id="sec4_container" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=12;arcSize=21;" value="&lt;b style=&quot;font-size: 15px; color: rgb(67, 56, 202);&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;4. HIGH-LEVEL ARCHITECTURE DIAGRAM &amp;amp; END-TO-END SYSTEM FLOWS&lt;/b&gt;" vertex="1">
          <mxGeometry height="590" width="1580" x="580" y="420" as="geometry" />
        </mxCell>
        <mxCell id="box_clients" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=1.5;verticalAlign=top;align=center;spacingTop=6;" value="&lt;div&gt;&lt;b style=&quot;font-size: 13px; color: rgb(30, 58, 138);&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;b style=&quot;font-size: 13px; color: rgb(30, 58, 138);&quot;&gt;CLIENT TIER&lt;/b&gt;" vertex="1">
          <mxGeometry height="420" width="220" x="600" y="525" as="geometry" />
        </mxCell>
        <mxCell id="node_client_tv" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=1.5;" value="&lt;b&gt;Smart TV Client&lt;/b&gt;&lt;br&gt;(Living Room Streaming)&lt;br&gt;&lt;i&gt;4K / 1080p Playback&lt;/i&gt;" vertex="1">
          <mxGeometry height="60" width="180" x="620" y="610" as="geometry" />
        </mxCell>
        <mxCell id="node_client_mob" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=1.5;" value="&lt;b&gt;Mobile App&lt;/b&gt;&lt;br&gt;(iOS / Android)&lt;br&gt;&lt;i&gt;Dynamic ABR (Cellular/Wi-Fi)&lt;/i&gt;" vertex="1">
          <mxGeometry height="60" width="180" x="618" y="690" as="geometry" />
        </mxCell>
        <mxCell id="node_client_web" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=1.5;" value="&lt;b&gt;Web Browser / Laptop&lt;/b&gt;&lt;br&gt;(Chrome, Firefox, Safari)&lt;br&gt;&lt;i&gt;HTML5 Video &amp;amp; DRM EME&lt;/i&gt;" vertex="1">
          <mxGeometry height="60" width="180" x="618" y="760" as="geometry" />
        </mxCell>
        <mxCell id="node_client_admin" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;" value="&lt;b&gt;Content Creator / Studio&lt;/b&gt;&lt;br&gt;(Production Admin Portal)&lt;br&gt;&lt;i&gt;Uploads Raw Master Videos&lt;/i&gt;" vertex="1">
          <mxGeometry height="85" width="180" x="618" y="840" as="geometry" />
        </mxCell>
